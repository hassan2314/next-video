# Copy to .env.local and replace the placeholders.
# Do not commit .env.local. Names below match the Vercel project.

# MongoDB connection string. The app uses the database named "test".
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/test

# Public site URL. Used by NextAuth and password-reset links.
NEXTAUTH_URL=http://localhost:3000
# Long random string. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Optional. Canonical URL for Open Graph tags.
# Defaults to https://next-video-rouge.vercel.app when unset.
# NEXT_PUBLIC_APP_URL=https://next-video-rouge.vercel.app

# Optional OAuth. Omit both values for a provider to hide that login path.
GOOGLE_ID=
GOOGLE_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ImageKit. Required only for uploading new video and thumbnail files.
NEXT_PUBLIC_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Optional. Gmail (or another Nodemailer service account) for password reset.
EMAIL_USER=
EMAIL_PASS=
